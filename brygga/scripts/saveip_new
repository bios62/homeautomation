curl -d '{"logname":"ipaddress_2","siteid":"brygga","logvalue":"'$IP'"}' -H 'Content-Type: application/json'  "https://tn1tv18ynzxubz5-iosp.adb.eu-frankfurt-1.oraclecloudapps.com/ords/iot/iotv1/iotstats/"


